# ===========================================================================
#  OIBSIP — repository-wide .gitignore
#
#  Each Flutter project also carries its own .gitignore generated by
#  `flutter create`. Git reads nested .gitignore files too, so these patterns
#  are a repo-wide safety net — they use **/ so they match at any depth,
#  no matter which task folder a file sits in.
# ===========================================================================

# --- Build output ----------------------------------------------------------
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/doc/api/

# --- Dart symbolication / obfuscation --------------------------------------
**/app.*.symbols
**/app.*.map.json

# --- Android ---------------------------------------------------------------
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/key.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/**/GeneratedPluginRegistrant.java
**/android/**/gradle-wrapper.jar
**/android/gradlew
**/android/gradlew.bat

# Signing material — never commit these
*.jks
*.keystore
**/key.properties

# --- iOS / macOS (unused here, keeps things tidy) --------------------------
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework/
**/ios/Flutter/Flutter.framework/
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Podfile.lock
**/ios/Pods/
**/ios/.symlinks/
**/macos/Flutter/ephemeral/
**/macos/Pods/
**/Podfile.lock

# --- Linux / Windows desktop ephemeral -------------------------------------
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/

# --- IDE / editor ----------------------------------------------------------
**/.idea/
*.iml
*.ipr
*.iws
**/.vscode/
*.swp
*.swo

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# --- Logs / scratch --------------------------------------------------------
*.log
*.class
.history/
migrate_working_dir/

# ===========================================================================
#  Deliberately NOT ignored — evaluators need these:
#    pubspec.lock   pins the exact dependency versions your build used
#    lib/           source code
#    test/          test suites
#    assets/        app logos
#    screenshots/   required by the OIBSIP per-task checklist
#    README.md      required by the OIBSIP per-task checklist
#
#  Note: gradlew / gradlew.bat / gradle-wrapper.jar are ignored above because
#  Flutter regenerates them on `flutter build`. A cloner runs `flutter pub get`
#  then `flutter build apk` and the tooling recreates the wrapper for them.
# ===========================================================================
