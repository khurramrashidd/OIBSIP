# Normalise line endings so the repo stores LF regardless of who commits,
# while Windows working copies still get CRLF. Keeps diffs clean when an
# evaluator clones on macOS or Linux.
* text=auto

# Source files — always LF in the repository
*.dart   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.xml    text eol=lf
*.gradle text eol=lf
*.kts    text eol=lf
*.properties text eol=lf

# Windows-only scripts keep CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary — never touch these
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.ttf    binary
*.otf    binary
*.jar    binary
*.apk    binary
*.aab    binary
*.keystore binary
*.jks    binary
